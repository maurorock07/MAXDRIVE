# ==============================================================================
# MAX DRIVE - Variáveis de Ambiente & Configuração de Banco de Dados
# ==============================================================================

# Porta do Servidor (Padrão: 3000)
PORT=3000

# Conexão com o Banco de Dados PostgreSQL:
# Se informada, o MAX DRIVE utilizará o PostgreSQL relacional como banco principal.
# Se deixada em branco ou não definida, o servidor utilizará o modo de resiliência local (JSON fallback).

# Opção 1: PostgreSQL Local (PostgreSQL instalado no Windows ou Docker)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maxdrive

# Opção 2: Supabase (PostgreSQL 100% Gratuito na Nuvem - Recomendado para Produção/APK)
# Crie seu banco em https://supabase.com em 2 minutos e cole a URI de conexão:
# DATABASE_URL=postgresql://postgres.xxxxxx:SuaSenha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Opção 3: Neon.tech (PostgreSQL Serverless Gratuito)
# Crie seu banco em https://neon.tech e cole a connection string:
# DATABASE_URL=postgresql://usuario:senha@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# Push Notifications (Firebase Cloud Messaging - Opcional para APK móvel)
# Necessário apenas para enviar notificações push para dispositivos Android/iOS.
# Obtenha em: https://console.firebase.google.com → Configurações → Cloud Messaging
# ─────────────────────────────────────────────────────────────────────────────
# FCM_SERVER_KEY=AAAAxxxxx:APA91bxxxxxxxxxxxx
